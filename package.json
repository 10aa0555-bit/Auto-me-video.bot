{
  "name": "shorts-animation-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "JSON台本から縦型ショートアニメ(1080x1920/30fps)をMP4で書き出すRemotionプロジェクト",
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "typecheck": "tsc --noEmit",
