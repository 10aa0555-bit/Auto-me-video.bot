  },
  "scenes": [
    {
      "narration": "This piece of land belongs to Russia... but it isn't connected to Russia at all.",
      "camera": {"center": [30, 56], "span": 62},
      "fill": {"RUS": "flag:ru", "RUS@20.5,54.7": "flag:ru"},
      "markers": [{"at": [20.9, 54.75], "type": "pulse", "color": "#ffd54f", "delay": 0.8}],
      "icons": [{"name": "thinking face", "at": [17.5, 59.0], "size": 190, "delay": 1.8}]
    },
    {
      "narration": "This is Kaliningrad, squeezed between Poland and Lithuania, over a thousand kilometers from Moscow.",
      "camera": {"center": [29.0, 55.0], "span": 24},
      "fill": {"POL": "flag:pl", "LTU": "flag:lt"},
      "markers": [
        {"at": [20.51, 54.71], "type": "pin", "label": "Kaliningrad", "delay": 0.4},
        {"at": [37.62, 55.75], "type": "pin", "label": "Moscow", "delay": 2.6}
      ],
      "lines": [{"path": [[20.51, 54.71], [37.62, 55.75]], "color": "#ffe14d", "style": "dashed", "width": 7,
                 "label": "auto", "delay": 2.8, "draw_time": 1.6}]
    },
    {
      "narration": "But for almost 700 years, this wasn't Russia. It was Königsberg, the heart of Prussia.",
      "year": "1255",
      "camera": {"center": [21.0, 54.1], "span": 7.5},
      "reset_fills": true,
      "fill": {"RUS@20.5,54.7": "#2f3b52", "east_prussia_south": "#2f3b52"},
      "icons": [
        {"name": "castle", "at": [20.6, 54.72], "size": 200, "label": "KÖNIGSBERG", "delay": 1.6},
        {"name": "crown", "at": [21.3, 53.85], "size": 150, "delay": 3.6}
      ]
    },
    {
      "narration": "Then came World War Two. Germany lost, and the land was split in half.",
      "year": "1945",
      "camera": {"center": [21.0, 54.2], "span": 7.5},
      "fill": {"RUS@20.5,54.7": "#c4453a", "east_prussia_south": "flag:pl"},
      "icons": [
        {"name": "fire", "at": [20.4, 54.6], "size": 130, "count": 3, "anim": "shake", "delay": 0.3},
        {"name": "military helmet", "at": [21.8, 54.0], "size": 150, "delay": 0.9}
      ],
      "lines": [{"path": [[19.3, 54.36], [22.8, 54.36]], "color": "#ffffff", "style": "dashed", "width": 9, "delay": 2.6}]
    },
    {
      "narration": "The Soviets took the north, expelled the Germans, and renamed the city Kaliningrad.",
      "year": "1946",
      "camera": {"center": [17.5, 54.0], "span": 15},
      "icons": [
        {"name": "person walking", "at": [20.6, 54.5], "to": [14.2, 53.2], "size": 110, "count": 5,
         "spread": 70, "delay": 1.2, "travel_time": 2.6},
        {"name": "classical building", "at": [20.51, 54.95], "size": 150, "label": "KALININGRAD", "delay": 3.6}
      ]
    },
    {
      "narration": "Back then, it didn't matter. Lithuania was part of the Soviet Union too.",
      "camera": {"center": [28, 55.5], "span": 32},
      "fill": {"LTU": "#c4453a", "LVA": "#c4453a", "EST": "#c4453a", "BLR": "#c4453a", "UKR": "#c4453a",
               "RUS": "#c4453a", "POL": null, "east_prussia_south": null},
      "texts": [{"text": "USSR", "at": [34, 55.5], "size": 120, "delay": 1.0}]
    },
    {
      "narration": "Then, in 1991, the Soviet Union collapsed. Lithuania broke away, and Kaliningrad was cut off.",
      "year": "1991",
      "flash": true,
      "camera": {"center": [24.5, 55.0], "span": 17},
      "fill": {"LTU": "flag:lt", "LVA": null, "EST": null, "BLR": null, "UKR": null,
               "RUS": "flag:ru", "RUS@20.5,54.7": "flag:ru"},
      "outline": ["RUS@20.5,54.7"],
      "icons": [{"name": "anxious face with sweat", "at": [20.9, 55.25], "size": 170, "anim": "shake", "delay": 3.4}]
    },
    {
      "narration": "Today, it's completely surrounded by NATO.",
      "camera": {"center": [22.0, 54.6], "span": 18},
      "fill": {"POL": "#1d4fd1", "LTU": "#1d4fd1", "LVA": "#1d4fd1", "EST": "#1d4fd1"},
      "icons": [
        {"name": "shield", "at": [19.5, 52.3], "size": 160, "delay": 0.6},
        {"name": "shield", "at": [24.0, 55.4], "size": 160, "delay": 0.9}
      ],
      "texts": [{"text": "NATO", "at": [22.0, 53.3], "size": 110, "delay": 1.2}]
    },
    {
      "narration": "Yet it's home to Russia's powerful Baltic Fleet.",
      "camera": {"center": [20.4, 54.9], "span": 6},
      "icons": [{"name": "ship", "at": [19.9, 54.7], "to": [19.2, 55.15], "size": 190, "delay": 0.4, "travel_time": 3.0, "label": "BALTIC FLEET"}]
    },
    {
      "narration": "And between Kaliningrad and Russia's ally Belarus lies a gap just 65 kilometers wide.",
      "camera": {"center": [23.3, 54.3], "span": 6.5},
      "fill": {"BLR": "flag:by"},
      "circles": [{"at": [23.15, 54.15], "radius_km": 45, "delay": 2.2}],
      "lines": [{"path": [[22.79, 54.36], [23.5, 53.94]], "color": "#ffe14d", "width": 10, "label": "{n} KM",
                 "count": 65, "delay": 2.6, "draw_time": 1.4}]
    },
    {
      "narration": "It's called the Suwałki Gap... and some call it the most dangerous place in Europe.",
      "camera": {"center": [23.3, 54.4], "span": 8},
      "outline": ["RUS@20.5,54.7", "BLR"],
      "lines": [
        {"path": [[21.3, 54.75], [22.85, 54.25]], "color": "#e53935", "style": "arrow", "width": 13, "delay": 0.8},
