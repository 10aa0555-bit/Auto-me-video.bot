# 音声生成 (npm run voice) で使用。どちらか一方を設定
TTS_PROVIDER=voicevox            # voicevox | elevenlabs

# VOICEVOX (ローカルで VOICEVOX Engine を起動しておく)
VOICEVOX_URL=http://127.0.0.1:50021
VOICEVOX_SPEAKER=3

# ElevenLabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# 台本自動生成 (将来拡張用)
OPENAI_API_KEY=
